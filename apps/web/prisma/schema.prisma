generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  NEEDS_REVIEW
  REJECTED
}

enum VerificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProviderStatus {
  HEALTHY
  WARNING
  OFFLINE
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  OCR_COMPLETED
  VERIFIED
  REJECTED
  EXPIRED
}

enum AIJobStatus {
  QUEUED
  PROCESSING
  WAITING_FOR_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum AuditAction {
  CREATED
  RETRIED
  CANCELLED
  COMPLETED
  FAILED
  PROCESSING
  WAITING_FOR_REVIEW
}

model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  email   String? @unique
  phone   String?
  website String?
  logoUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates          Candidate[]
  users               User[]
  roles               Role[]
  documents           Document[]
  aiJobs              AIJob[]
  aiproviders         AIProvider[]
  verificationResults VerificationResult[]
  verificationRules   VerificationRule[]

  webhookEndpoints    WebhookEndpoint[]
  webhookEvents       WebhookEvent[]

  clients             Client[]
  packages            Package[]

  departments         Department[]
  designations        Designation[]
  approvalLevels      ApprovalLevel[]
}

model Candidate {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  isActive  Boolean @default(true)

  dateOfBirth   DateTime? @db.Date
  panNumber     String?
  aadhaarNumber String?

  middleName       String?
  gender           String?
  fatherName       String?
  motherName       String?
  alternatePhone   String?
  currentAddress   String? @db.Text
  permanentAddress String? @db.Text
  emergencyContact Json?   
  nationality      String?
  maritalStatus    String?
  languages        String[]
  candidateStatus  String? @default("ACTIVE")
  photoUrl         String?
  
  maskedAadhaar    String?
  maskedPan        String?
  passportNumber   String?
  drivingLicense   String?
  voterId          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  verifications VerificationRequest[]
  documents     Document[]
  jobs          AIJob[]

  verificationResults VerificationResult[]

  aiProviders AIProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationResult {
  id String @id @default(cuid())

  overallStatus VerificationStatus
  riskScore     Int
  riskLevel     String
  confidence    Float

  matchedFields    Json
  mismatchedFields Json

  recommendations String[]
  explanation     String?  @db.Text

  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobId          String?      @unique
  job            AIJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  verificationCheckId String?
  verificationCheck   VerificationCheck? @relation(fields: [verificationCheckId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationRule {
  id             String  @id @default(cuid())
  organizationId String
  documentType   String
  fieldName      String
  mismatchScore  Int
  mustMatch      Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, fieldName])
}

model AIProvider {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  code           String
  version        String
  status         ProviderStatus @default(HEALTHY)
  priority       Int            @default(0)
  enabled        Boolean        @default(true)

  supportedFeatures String[]

  costPerRequest Float?
  costPerPage    Float?

  metrics AIProviderMetric[]
  jobs    AIJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates   Candidate[]

  @@unique([organizationId, code])
}

model AIProviderMetric {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime @db.Date

  totalRequests Int   @default(0)
  successCount  Int   @default(0)
  failureCount  Int   @default(0)
  avgTimeMs     Int   @default(0)
  avgConfidence Float @default(0)
  retries       Int   @default(0)

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
}

model VerificationRequest {
  id       String               @id @default(cuid())
  type     String // e.g. "CRIMINAL_RECORD", "EMPLOYMENT", "EDUCATION"
  status   RequestStatus        @default(PENDING) // e.g. "PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"
  priority VerificationPriority @default(NORMAL)
  notes  String?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id])

  checks      VerificationCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationCheck {
  id                    String @id @default(cuid())
  verificationRequestId String
  category              String // "EMPLOYMENT", "EDUCATION", "IDENTITY", "CRIMINAL"
  subCategory           String? // e.g. "PhD", "Employment 1"
  status                RequestStatus @default(PENDING)
  
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  documents             Document[]
  verificationResults   VerificationResult[]
  
  workAssignment        WorkAssignment?
  approvalRequests      ApprovalRequest[]
}

model Client {
  id             String @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests       VerificationRequest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Package {
  id             String @id @default(cuid())
  organizationId String
  name           String // e.g. "Executive", "Basic"
  checksConfig   Json   // Defines array of Verification Categories to auto-generate
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests       VerificationRequest[]
}

model TimelineEvent {
  id                    String @id @default(cuid())
  candidateId           String
  verificationRequestId String?
  documentId            String?
  action                String // e.g., "STATUS_CHANGED", "AI_STARTED"
  description           String
  metadata              Json?
  createdAt             DateTime @default(now())
}

model SystemAuditLog {
  id             String @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  details        Json?
  createdAt      DateTime @default(now())
}


model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roles    UserRole[]
  sessions Session[]
  accounts Account[]
  
  employeeProfile EmployeeProfile?

  uploadedDocuments Document[] @relation("UploadedDocuments")
  verifiedDocuments Document[] @relation("VerifiedDocuments")

  verifiedExtractions AIExtraction[] @relation("VerifiedExtractions")
  performedAILogs     AIAuditLog[]   @relation("PerformedAILogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String @id @default(cuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users           UserRole[]
  permissions     Permission[] // Deprecated, keep for 1 sprint
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "users:read", "users:write"
  description String?
  roles       Role[] // Deprecated, keep for 1 sprint
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// WORKFORCE HIERARCHY
// ----------------------------------------------------

model Department {
  id             String @id @default(cuid())
  organizationId String
  name           String // e.g., "Operations", "Quality Assurance", "IT"
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles       EmployeeProfile[]
}

model Designation {
  id             String @id @default(cuid())
  organizationId String
  name           String // e.g., "Verification Agent", "Team Leader"
  level          Int    // Numeric hierarchy level (1 = Super Admin, 5 = Agent)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles       EmployeeProfile[]
}

model ApprovalLevel {
  id             String @id @default(cuid())
  organizationId String
  name           String // e.g., "L1 Approval", "Final QA Approval"
  priority       Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles       EmployeeProfile[]
}

model EmployeeProfile {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  employeeId       String?   @unique
  joiningDate      DateTime? @db.Date
  emergencyContact String?
  officeLocation   String?
  
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id])
  
  approvalLevelId String?
  approvalLevel   ApprovalLevel? @relation(fields: [approvalLevelId], references: [id])
  
  // Hierarchy Management
  managerId      String?
  manager        EmployeeProfile?  @relation("ReportingHierarchy", fields: [managerId], references: [id])
  subordinates   EmployeeProfile[] @relation("ReportingHierarchy")
  
  // Workflow Engine
  assignedWork        WorkAssignment[]  @relation("AssignedWork")
  assignedByWork      WorkAssignment[]  @relation("AssignedBy")
  approvalRequests    ApprovalRequest[] @relation("ApprovalRequester")
  approvalReviews     ApprovalRequest[] @relation("ApprovalReviewer")
  notifications       NotificationEvent[] @relation("Notifications")
}

// ----------------------------------------------------
// ENHANCED RBAC
// ----------------------------------------------------

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ----------------------------------------------------
// WORKFLOW & ASSIGNMENTS
// ----------------------------------------------------

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SLAStatus {
  ON_TRACK
  DELAYED
  OVERDUE
}

model WorkAssignment {
  id                  String   @id @default(cuid())
  verificationCheckId String   @unique 
  assigneeId          String   // EmployeeProfile ID
  assignedById        String?  // Who assigned it
  
  status              AssignmentStatus @default(PENDING)
  slaStatus           SLAStatus        @default(ON_TRACK)
  
  assignedAt          DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  slaDueDate          DateTime?
  
  verificationCheck   VerificationCheck @relation(fields: [verificationCheckId], references: [id], onDelete: Cascade)
  assignee            EmployeeProfile   @relation("AssignedWork", fields: [assigneeId], references: [id])
  assignedBy          EmployeeProfile?  @relation("AssignedBy", fields: [assignedById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SENT_BACK
  ESCALATED
}

enum RequestType {
  APPROVAL
  CORRECTION
  ESCALATION
  RE_OPEN
  EXTENSION
  CLARIFICATION
}

model ApprovalRequest {
  id                  String   @id @default(cuid())
  verificationCheckId String
  requesterId         String   // Agent submitting the request
  reviewerId          String?  // QA/Manager reviewing it
  
  type                RequestType    @default(APPROVAL)
  status              ApprovalStatus @default(PENDING)
  comments            String?
  
  verificationCheck   VerificationCheck @relation(fields: [verificationCheckId], references: [id], onDelete: Cascade)
  requester           EmployeeProfile   @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer            EmployeeProfile?  @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ----------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------

model NotificationEvent {
  id             String   @id @default(cuid())
  organizationId String
  recipientId    String   // EmployeeProfile ID
  title          String
  message        String
  isRead         Boolean  @default(false)
  link           String?  // Deep link to the task
  
  recipient      EmployeeProfile @relation("Notifications", fields: [recipientId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime
}

model Document {
  id               String         @id @default(cuid())
  documentType     String // "Aadhaar", "PAN", "Passport", etc.
  fileName         String // Internal storage name
  originalFileName String // The original uploaded file name
  mimeType         String
  fileSize         Int // In bytes
  storagePath      String
  storageProvider  String         @default("SUPABASE")
  status           DocumentStatus @default(UPLOADED) // "UPLOADED", "PROCESSING", "OCR_COMPLETED", "VERIFIED", "REJECTED", "EXPIRED"
  notes            String?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)

  verifiedById String?
  verifiedBy   User?   @relation("VerifiedDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  aiJobs AIJob[]

  isDeleted Boolean @default(false)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  verificationResults VerificationResult[]
  
  verificationCheckId String?
  verificationCheck   VerificationCheck? @relation(fields: [verificationCheckId], references: [id], onDelete: SetNull)
}

model AIJob {
  id String @id @default(cuid())

  jobType    String // OCR, DOCUMENT_CLASSIFICATION, RESUME_PARSING, etc.
  status     AIJobStatus @default(QUEUED) // QUEUED, PROCESSING, WAITING_FOR_REVIEW, COMPLETED, FAILED, CANCELLED
  priority   Int         @default(0) // Higher number = higher priority
  retryCount Int         @default(0)

  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  confidenceScore Float?
  processingTime  Int? // In milliseconds

  provider        String? // e.g. "MOCK", "GOOGLE_VISION", "AZURE_DOCUMENT_INTELLIGENCE"
  providerId      String? // Optional link to AIProvider record
  modelVersion    String?
  rawText         String? @db.Text
  structuredJson  Json?
  validationScore Float?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  aiProvider AIProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  extractions AIExtraction[]
  auditLogs   AIAuditLog[]

  verificationResult VerificationResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIExtraction {
  id String @id @default(cuid())

  fieldName  String
  fieldValue String @db.Text
  confidence Float

  validationError String?
  isAutoVerified  Boolean @default(false)

  verified     Boolean @default(false)
  verifiedById String?
  verifiedBy   User?   @relation("VerifiedExtractions", fields: [verifiedById], references: [id], onDelete: SetNull)

  jobId String
  job   AIJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIAuditLog {
  id String @id @default(cuid())

  action AuditAction // CREATED, RETRIED, CANCELLED, COMPLETED, FAILED, PROCESSING, WAITING_FOR_REVIEW
  notes  String?     @db.Text

  performedById String?
  performedBy   User?   @relation("PerformedAILogs", fields: [performedById], references: [id], onDelete: SetNull)

  jobId String
  job   AIJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  isActive       Boolean  @default(true)
  events         String[] // Array of event types
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WebhookEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  createdAt      DateTime @default(now())
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  endpointId     String
  eventId        String
  status         String   // PENDING, SUCCESS, FAILED
  statusCode     Int?
  attempts       Int      @default(0)
  lastAttemptAt  DateTime?

  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
